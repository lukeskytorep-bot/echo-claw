{
  "id": "echo-claw",
  "name": "ECHO-CLAW",
  "description": "Blind Remote Viewing session orchestration with durable Session Core, Vault, Reveal Gate, and persistent OpenClaw Viewer sessions.",
  "version": "0.3.4",
  "categories": [
    "other"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "echo_owner_session",
      "echo_monitor_session"
    ],
    "conversationAccess": [
      "read"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dataDir": {
        "type": "string",
        "description": "Durable ECHO-CLAW runtime data directory."
      },
      "ownerAgentId": {
        "type": "string",
        "default": "main"
      },
      "monitorAgentId": {
        "type": "string",
        "default": "echo-monitor"
      },
      "viewerAgentId": {
        "type": "string",
        "default": "echo-viewer"
      }
    }
  }
}
