{
  "name": "@presence-beyond-form/echo-claw",
  "version": "0.4.0-rc.4",
  "private": true,
  "type": "module",
  "description": "ECHO-CLAW ECHO-4 release candidate: durable Session Core, native OpenClaw integration, installer and real-host validation gates.",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0 <27"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:verbose": "node tools/run-tests.mjs --reporter=spec",
    "verify:package": "node tools/verify-package.mjs",
    "verify:baselines": "node tools/verify-baselines.mjs",
    "check": "npm test && npm run verify:baselines && npm run verify:package",
    "test:echo3": "node tools/run-tests.mjs --scope=echo3",
    "test:echo2": "node tools/run-tests.mjs --scope=echo2",
    "test:echo4": "node tools/run-tests.mjs --scope=echo4",
    "echo4:preflight": "node installer/echo4-install.mjs preflight --require-gateway --json",
    "echo4:plan": "node installer/echo4-install.mjs plan --json",
    "echo4:self-test": "node installer/echo4-host-self-test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeskytorep-bot/echo-claw.git"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.7 <2026.12.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.7 <2026.12.0",
      "minGatewayVersion": "2026.11.7"
    },
    "build": {
      "openclawVersion": "2026.11.7",
      "pluginSdkVersion": "2026.11.7"
    }
  },
  "files": [
    "dist",
    "src",
    "runtime",
    "protocol-pack",
    "targets",
    "agents",
    "docs",
    "installer",
    "openclaw.plugin.json",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTORS.md",
    "CITATION.cff"
  ]
}
