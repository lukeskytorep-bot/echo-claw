{
  "name": "@presence-beyond-form/echo-claw",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "ECHO-CLAW ECHO-3: durable Session Core plus native OpenClaw Monitor/Viewer integration.",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:verbose": "node --test --test-reporter=spec tests/*.test.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "verify:baselines": "node tools/verify-baselines.mjs",
    "check": "npm test && npm run verify:baselines && npm run verify:package",
    "test:echo3": "node --test tests/echo3-openclaw.test.mjs",
    "test:echo2": "node --test tests/echo2.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeskytorep-bot/echo-claw.git"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.7 <2026.12.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.7 <2026.12.0",
      "minGatewayVersion": "2026.11.7"
    },
    "build": {
      "openclawVersion": "2026.11.7",
      "pluginSdkVersion": "2026.11.7"
    }
  },
  "files": [
    "dist",
    "src",
    "runtime",
    "protocol-pack",
    "targets",
    "agents",
    "docs",
    "openclaw.plugin.json",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTORS.md",
    "CITATION.cff"
  ]
}
